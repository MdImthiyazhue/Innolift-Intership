{
  "info": {
    "name": "Student Management API",
    "description": "Day 45 — API testing collection for the Student Management project (React + Flask + MySQL). Covers valid requests, invalid inputs, duplicate data, and invalid routes/methods.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" }
